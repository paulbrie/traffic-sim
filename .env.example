# Postgres started with `docker compose up -d` (port 5544 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://traffic:traffic@localhost:5544/traffic

# First admin account, created by `npm run db:admin` (must be changed at first sign-in)
ADMIN_EMAIL=paul.brie@teleporthq.io
ADMIN_PASSWORD=

# Serve the app under a sub-path, e.g. /trafficsim (leave empty to serve at the root). Needs a restart / rebuild.
NEXT_PUBLIC_BASE_PATH=

# Google Maps Platform key (optional, inlined at build time). Enables "Google" imagery under geo-located plans
# (Map Tiles API, 2D satellite tiles) and the photorealistic 3D city. Enable the Map Tiles API for it and
# restrict it to your site's referrers, since it is visible to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
